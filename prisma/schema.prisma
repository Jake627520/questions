generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ResponseStatus {
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  single_choice
  multiple_choice
  text
  number
  yes_no
  info
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ImportStatus {
  PREVIEW
  IMPORTING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?  @map("avatar_url")
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  createdSurveys Survey[]       @relation("SurveyCreator")
  surveyImports  SurveyImport[]
  sessions       Session[]
  invitations    Invitation[]   @relation("InvitationCreator")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  surveys       Survey[]
  surveyImports SurveyImport[]
  invitations   Invitation[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           Role     @default(EDITOR)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  invitedEmail   String    @map("invited_email")
  role           Role      @default(VIEWER)
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tokenHash])
  @@index([invitedEmail])
  @@map("invitations")
}

model Survey {
  id              String       @id @default(cuid())
  publicToken     String?      @unique @map("public_token")
  organizationId  String       @map("organization_id")
  createdById     String?      @map("created_by_id")
  parentSurveyId  String?      @map("parent_survey_id")
  version         Int          @default(1)
  title           String
  description     String?      @db.Text
  status          SurveyStatus @default(DRAFT)
  isAnonymous     Boolean      @default(true) @map("is_anonymous")
  collectIdentity Boolean      @default(false) @map("collect_identity")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation("SurveyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parentSurvey  Survey?        @relation("SurveyVersions", fields: [parentSurveyId], references: [id], onDelete: SetNull)
  childVersions Survey[]       @relation("SurveyVersions")
  questions     Question[]
  responses     Response[]
  surveyImports SurveyImport[]

  @@index([organizationId])
  @@map("surveys")
}

model SurveyImport {
  id             String  @id @default(cuid())
  importId       String  @unique @map("import_id")
  surveyId       String? @map("survey_id")
  organizationId String  @map("organization_id")
  createdById    String? @map("created_by_id")

  fileName String?      @map("file_name")
  fileSize Int?         @map("file_size")
  mode     String       @default("save")
  status   ImportStatus @default(IMPORTING)

  questionCount    Int @default(0) @map("question_count")
  choiceCount      Int @default(0) @map("choice_count")
  requiredCount    Int @default(0) @map("required_count")
  scoredCount      Int @default(0) @map("scored_count")
  conditionalCount Int @default(0) @map("conditional_count")

  copyrightConfirmed Boolean @default(false) @map("copyright_confirmed")

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message") @db.Text
  errorDetails String? @map("error_details") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  survey       Survey?      @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([surveyId])
  @@index([status])
  @@index([createdAt])
  @@map("survey_imports")
}

model Question {
  id              String       @id @default(cuid())
  surveyId        String       @map("survey_id")
  orderNum        Int          @map("order_num")
  code            String
  title           String
  description     String?      @db.Text
  questionType    QuestionType @map("question_type")
  required        Boolean      @default(false)
  scoringEnabled  Boolean      @default(false) @map("scoring_enabled")
  reverseScore    Boolean      @default(false) @map("reverse_score")
  visibilityRules String?      @map("visibility_rules") @db.Text
  visibilityHint  String?      @map("visibility_hint") @db.Text
  minSelections   Int?         @map("min_selections")
  maxSelections   Int?         @map("max_selections")
  minValue        Float?       @map("min_value")
  maxValue        Float?       @map("max_value")
  createdAt       DateTime     @default(now()) @map("created_at")

  survey  Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  choices Choice[]
  answers Answer[]

  @@unique([surveyId, code])
  @@index([surveyId, orderNum])
  @@map("questions")
}

model Choice {
  id            String  @id @default(cuid())
  questionId    String  @map("question_id")
  orderNum      Int     @map("order_num")
  label         String
  value         String
  scoreEnabled  Boolean @default(false) @map("score_enabled")
  score         Float?
  isOther       Boolean @default(false) @map("is_other")
  requiresText  Boolean @default(false) @map("requires_text")
  isNoneOfAbove Boolean @default(false) @map("is_none_of_above")

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AnswerChoice[]

  @@index([questionId, orderNum])
  @@map("choices")
}

model Response {
  id          String         @id @default(cuid())
  surveyId    String         @map("survey_id")
  version     Int            @default(1)
  status      ResponseStatus @default(COMPLETED)
  totalScore  Float?         @map("total_score")
  maxScore    Float?         @map("max_score")
  percentage  Float?
  submittedAt DateTime?      @map("submitted_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  survey  Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([surveyId])
  @@map("responses")
}

model Answer {
  id         String  @id @default(cuid())
  responseId String  @map("response_id")
  questionId String  @map("question_id")
  rawValue   String  @map("raw_value") @db.Text
  otherText  String? @map("other_text") @db.Text
  score      Float?

  response Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choices  AnswerChoice[]

  @@index([responseId])
  @@index([questionId])
  @@map("answers")
}

model AnswerChoice {
  id        String   @id @default(cuid())
  answerId  String   @map("answer_id")
  choiceId  String   @map("choice_id")
  createdAt DateTime @default(now()) @map("created_at")

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  choice Choice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@unique([answerId, choiceId])
  @@index([answerId])
  @@index([choiceId])
  @@map("answer_choices")
}
