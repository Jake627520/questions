# PostgreSQL connection for Prisma.
# User, password, database, and port match docker-compose.yml and CI
# (.github/workflows/ci.yml): postgres / postgrespassword / survey_db / 5432.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/survey_db?schema=public"

# Bearer secret for POST /api/cron/cleanup (Vercel Cron and manual calls).
# The route fails closed with 503 when this is unset. Use a long random string.
# Send it as `Authorization: Bearer <CRON_SECRET>` or header `x-cron-secret`.
CRON_SECRET="replace-with-a-long-random-string"

# Absolute origin used for metadataBase, canonical URL, and Open Graph.
# No path and no trailing slash. When unset, the app falls back to
# https://questions-survey-system1.vercel.app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. HMAC key for hashing respondent IPs (src/lib/submission-integrity.ts).
# When unset, the app uses a built-in salt. Set a private value in production
# if that salt should be rotatable.
# RESPONSE_IP_HMAC_SECRET="replace-with-a-long-random-string"

# Optional. How many trusted proxy hops to skip when reading X-Forwarded-For.
# Default is 1.
# TRUSTED_PROXY_HOPS="1"
