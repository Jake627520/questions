{
  "name": "survey-system-mvp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "generate:excel": "tsx scripts/generate-demo-excel.ts",
    "generate:complex-excel": "tsx scripts/generate-complex-demo-excel.ts",
    "check:gitignore": "node -e \"const { execSync } = require('child_process'); const files = ['.env', '.env.local', 'node_modules', '.next', '.DS_Store']; let hasError = false; files.forEach(f => { try { execSync('git check-ignore -q ' + f, {stdio: 'ignore'}); console.log('✅ 已忽略:', f); } catch { console.log('❌ 未被忽略:', f); hasError = true; } }); if (hasError) process.exit(1);\""
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.428.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.41",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.9",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
