{
  "name": "survey-system-mvp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "node scripts/start-standalone.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "generate:excel": "tsx scripts/generate-demo-excel.ts",
    "generate:complex-excel": "tsx scripts/generate-complex-demo-excel.ts",
    "check:gitignore": "node -e \"const { execSync } = require('child_process'); const files = ['.env', '.env.local', 'node_modules', '.next', '.DS_Store']; let hasError = false; files.forEach(f => { try { execSync('git check-ignore -q ' + f, {stdio: 'ignore'}); console.log('✅ 已忽略:', f); } catch { console.log('❌ 未被忽略:', f); hasError = true; } }); if (hasError) process.exit(1);\""
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.428.0",
    "next": "^15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.29",
    "postcss": "8.5.32",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.9",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "uuid": "11.1.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
